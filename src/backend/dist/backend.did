type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserId = principal;
type TransformationModel = 
 variant {
   affine;
   homography;
   similarity;
 };
type Timestamp = int;
type Thresholds = 
 record {
   minInlierRatio: float64;
   ransacReprojThreshold: float64;
 };
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_2 = 
 variant {
   err: Error;
   ok;
 };
type Result_1 = 
 variant {
   err: JobError;
   ok: JobId;
 };
type Result = 
 variant {
   err: JobError;
   ok;
 };
type ReproConfig = 
 record {
   detector: DetectorConfig;
   matching: MatchingConfig;
   model: TransformationModel;
   preprocessing: PreprocessingSettings;
   thresholds: Thresholds;
 };
type PreprocessingSettings = 
 record {
   contrastEnhancement: bool;
   denoise: bool;
   grayscale: bool;
   resizeHeight: opt nat;
   resizeWidth: opt nat;
 };
type Point2D = 
 record {
   x: float64;
   y: float64;
 };
type Matrix3x3 = vec float64;
type MatchingConfig = 
 record {
   crossCheck: bool;
   maxMatches: nat;
   ratioThreshold: float64;
 };
type JobSummary = 
 record {
   createdAt: Timestamp;
   id: JobId;
   model: TransformationModel;
   referenceName: text;
   sourceName: text;
   status: JobStatus;
 };
type JobStatus = 
 variant {
   completed;
   failed;
   pending;
   processing;
 };
type JobResult = 
 record {
   correspondences: vec CorrespondencePoint;
   metrics: JobMetrics;
   registeredOutput: ImageRef;
   report: text;
   transformationMatrix: Matrix3x3;
 };
type JobMetrics = 
 record {
   inlierCount: opt nat;
   outlierCount: opt nat;
   reprojectionError: opt float64;
   rmse: opt float64;
   rotationDegrees: opt float64;
   scale: opt float64;
   spatialCoverage: opt float64;
 };
type JobId = nat;
type JobError = 
 variant {
   invalidConfig: text;
   notFound: JobId;
 };
type Job = 
 record {
   config: ReproConfig;
   createdAt: Timestamp;
   error: opt text;
   id: JobId;
   owner: UserId;
   referenceImage: InputImage;
   result: opt JobResult;
   sourceImage: InputImage;
   status: JobStatus;
 };
type InputImage = 
 record {
   metadata: ImageMetadata;
   ref: ImageRef;
 };
type ImageRef = text;
type ImageMetadata = 
 record {
   format: text;
   height: nat;
   name: text;
   sizeBytes: nat;
   width: nat;
 };
type FeatureDetector = 
 variant {
   brisk;
   kaze;
   orb;
   sift;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type DetectorConfig = 
 record {
   detector: FeatureDetector;
   edgeThreshold: nat;
   maxFeatures: nat;
   nLevels: nat;
   scaleFactor: float64;
 };
type CorrespondencePoint = 
 record {
   reference: Point2D;
   source: Point2D;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_2);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createJob: (source: InputImage, reference: InputImage, config:
   ReproConfig) -> (Result_1);
  deleteJob: (jobId: JobId) -> (Result);
  execute: (qJson: text) -> (Result__1) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getJob: (jobId: JobId) -> (opt Job) query;
  isCallerAdmin: () -> (bool) query;
  listJobs: () -> (vec JobSummary) query;
  schema: () -> (text) query;
  updateJobResult: (jobId: JobId, result: JobResult) -> (Result);
}
